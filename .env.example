# =====================================================
# Oud Index Platform — Environment Variables
# انسخ هذا الملف إلى .env.local وامل القيم
# =====================================================

# ----- Supabase (قاعدة البيانات + المصادقة) -----
# احصلي عليها من: https://supabase.com/dashboard/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- Resend (إرسال الإيميلات) -----
# احصلي عليه من: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Oud Index <noreply@oudindex.com>"
EMAIL_ADMIN=admin@oudindex.com

# ----- Site Settings -----
NEXT_PUBLIC_SITE_URL=https://oudindex.com
NEXT_PUBLIC_SITE_NAME="Oud Index | مؤشر العود"

# ----- Admin Access -----
# قائمة إيميلات المشرفين (مفصولة بفواصل)
ADMIN_EMAILS=mariam.s.alotaibi@gmail.com
